{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cun-zoom-accounts",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "../web", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "cun-zoom-accounts", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "EMAIL_FROM": "",
    "SMS_ENABLED": "false",
    "OTP_DAILY_LIMIT": "100",
    "DOWNLOAD_URL": "https://github.com/Thequancute215-sys/cun-zoom/releases"
  },
  "observability": { "enabled": false }
}
